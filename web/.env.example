# StoMar API key for protected endpoints.
# Must match STOMAR_API_KEY in the root .env. Without it, protected endpoints
# (paper-trading, ledger, pipeline, automation, risk-guard) return 401/503 and
# the corresponding UI pages show errors.
# Copy to .env.local (gitignored) or export VITE_STOMAR_API_KEY at build time.
VITE_STOMAR_API_KEY=
