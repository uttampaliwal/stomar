# StoMar API Configuration
# Copy this file to .env and set your values.

# Environment: "dev" (default) or "production".
# Production restricts CORS to STOMAR_CORS_ORIGINS and requires API key on write endpoints.
STOMAR_ENV=dev

# API key for protecting write endpoints (POST/PUT/PATCH/DELETE).
# If empty or unset, auth is disabled (suitable for local dev).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STOMAR_API_KEY=

# Comma-separated list of allowed CORS origins (production only).
# Example: https://stomar.example.com,https://admin.stomar.example.com
STOMAR_CORS_ORIGINS=
