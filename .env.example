# StoMar Configuration
# Copy this file to .env and set your values.
# All variables use the STOMAR_ prefix (e.g., STOMAR_API_KEY).
# Defaults match the hardcoded values in the source code.

# ── Environment ────────────────────────────────────────────────────────────
# "dev" (default) or "production"
STOMAR_ENV=dev

# API key for protecting write endpoints (POST/PUT/PATCH/DELETE).
# If empty or unset, auth is disabled (suitable for local dev).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STOMAR_API_KEY=

# Comma-separated list of allowed CORS origins (production only).
# Example: https://stomar.example.com,https://admin.stomar.example.com
STOMAR_CORS_ORIGINS=

# ── Trading Costs (NSE India) ──────────────────────────────────────────────
# STOMAR_BROKERAGE_RATE=0.0003
# STOMAR_SLIPPAGE_RATE=0.001
# STOMAR_STT_RATE=0.001
# STOMAR_EXCHANGE_CHARGE_RATE=0.0000345
# STOMAR_SEBI_FEES_RATE=0.000001
# STOMAR_STAMP_DUTY_BUY_RATE=0.00015
# STOMAR_GST_RATE=0.18

# ── Risk Parameters ────────────────────────────────────────────────────────
# STOMAR_RISK_FREE_RATE=0.065

# ── Model Training ─────────────────────────────────────────────────────────
# STOMAR_DEFAULT_SEQ_LENGTH=60
# STOMAR_DEFAULT_EPOCHS=40
# STOMAR_DEFAULT_BATCH_SIZE=32
# STOMAR_DEFAULT_LEARNING_RATE=0.001

# ── API Cache ──────────────────────────────────────────────────────────────
# STOMAR_CACHE_TTL=30
# STOMAR_CACHE_MAX_ENTRIES=50

# ── Data Cache ─────────────────────────────────────────────────────────────
# STOMAR_FETCH_CACHE_TTL=600
# STOMAR_MODEL_CACHE_TTL=3600

# ── Meta-Controller ────────────────────────────────────────────────────────
# STOMAR_MAX_POSITION_PCT=0.10
# STOMAR_BUY_THRESHOLD=0.6
# STOMAR_SELL_THRESHOLD=0.4
# STOMAR_MIN_CONFIDENCE_TO_TRADE=0.3

# ── Risk Controls ──────────────────────────────────────────────────────────
# STOMAR_MAX_DAILY_LOSS_PCT=0.02
# STOMAR_MAX_WEEKLY_LOSS_PCT=0.05
# STOMAR_MAX_DRAWDOWN_PCT=0.15

# ── Orchestrator ───────────────────────────────────────────────────────────
# STOMAR_MAX_DAILY_TRADES=5
# STOMAR_MAX_PORTFOLIO_EXPOSURE=0.50
# STOMAR_STOP_LOSS_PCT=0.05

# ── Circuit Breaker ────────────────────────────────────────────────────────
# STOMAR_YF_FAILURE_THRESHOLD=5
# STOMAR_YF_RECOVERY_TIMEOUT=120
# STOMAR_NSE_FAILURE_THRESHOLD=3
# STOMAR_NSE_RECOVERY_TIMEOUT=90

# ── Pipeline ───────────────────────────────────────────────────────────────
# STOMAR_MIN_OOS_ACCURACY=0.50
# STOMAR_MIN_OOS_SHARPE=0.0
# STOMAR_MAX_DRAWDOWN_THRESHOLD=0.30

# ── Live Market Data (free tier) ────────────────────────────────────────────
# Quote polling interval in seconds (3s-5s recommended).
# STOMAR_LIVE_POLL_INTERVAL=3.0
# Symbols polled by the live engine (comma-separated).
# STOMAR_LIVE_UNIVERSE=RELIANCE.NS,TCS.NS,HDFCBANK.NS

# Zerodha Kite Connect — optional premium plug-in. When both are set, the
# live engine uses Kite as the primary source (WebSocket-ready).
# STOMAR_KITE_API_KEY=
# STOMAR_KITE_ACCESS_TOKEN=

# ── Notifications (P5.1 + B7) ────────────────────────────────────────────────
# Daily paper-trading summary + critical alerts. At least one channel needed.
# Telegram: token from @BotFather, chat id of the destination (numeric).
# STOMAR_TELEGRAM_BOT_TOKEN=
# STOMAR_TELEGRAM_CHAT_ID=
# Email: SMTP (Gmail app password recommended).
# STOMAR_SMTP_HOST=smtp.gmail.com
# STOMAR_SMTP_PORT=587
# STOMAR_SMTP_USER=
# STOMAR_SMTP_PASSWORD=
# STOMAR_SMTP_TO=you@example.com

# Risk Guard (hardware circuit breakers). Token required to manually resume
# trading after a cumulative drawdown freeze (compare_digest, never logged).
# STOMAR_RISK_OVERRIDE_TOKEN=
# STOMAR_GUARD_DAILY_LOSS_PCT=0.02
# STOMAR_GUARD_MAX_DRAWDOWN_PCT=0.08
# STOMAR_GUARD_MAX_STOCK_ALLOCATION_PCT=0.15
# STOMAR_GUARD_VIX_THRESHOLD=22
# STOMAR_GUARD_ATR_EXPANSION_THRESHOLD=2.0
